# Copy to .env — NEVER commit real keys.
# Paper mode works without these; live / doctor / livetest need them.

# Signer private key (hot wallet with ONLY the trading bankroll)
PK=0xYOUR_PRIVATE_KEY

# Polymarket deposit / funder address shown in the UI (not always the EOA)
BROWSER_ADDRESS=0xYOUR_DEPOSIT_ADDRESS

# Optional overrides
# POLYGON_RPC=https://polygon-bor-rpc.publicnode.com
# ALL_PROXY=  # optional SOCKS/HTTP proxy
# ALERT_WEBHOOK_URL=

# Telegram notify/control side-channel (optional). Paste real values locally only.
# Create a bot with @BotFather → TELEGRAM_BOT_TOKEN; message the bot → TELEGRAM_CHAT_ID.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_CONFIRM=0   # 1 = Approve/Deny before first place of day / size bumps

# Builder/relayer creds only needed for Safe/deposit merge paths
# POLY_BUILDER_KEY=
# POLY_BUILDER_SECRET=
# POLY_BUILDER_PASSPHRASE=
# POLY_RELAYER_URL=https://relayer-v2.polymarket.com
