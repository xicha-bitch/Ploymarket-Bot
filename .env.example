# Live-only microbot — copy to .env on YOUR machine/VM.
# NEVER commit .env. NEVER paste PK into chat / tickets / PR comments.
#
# Cursor Cloud Agents: add the same names as Environment Secrets in the
# dashboard (values never belong in git or docs). Required names:
#   PK
#   BROWSER_ADDRESS

# Signer private key — hot wallet that holds ONLY this trading bankroll
PK=0xYOUR_PRIVATE_KEY

# Polymarket deposit / funder address from the Polymarket UI
# (often a proxy/deposit address — not always the same as the EOA)
BROWSER_ADDRESS=0xYOUR_DEPOSIT_ADDRESS

# Optional overrides
# POLYGON_RPC=https://polygon-bor-rpc.publicnode.com
# ALL_PROXY=  # optional SOCKS/HTTP proxy (process env; not a Cursor app secret)
# ALERT_WEBHOOK_URL=

# Builder/relayer creds — only for Safe/deposit merge paths
# POLY_BUILDER_KEY=
# POLY_BUILDER_SECRET=
# POLY_BUILDER_PASSPHRASE=
# POLY_RELAYER_URL=https://relayer-v2.polymarket.com
